# Aplicação
APP_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecf
DB_USER=postgres
DB_PASSWORD=preencha_localmente
# Banco usado para verificar/criar DB_NAME. Em instalações padrão, use postgres.
DB_MAINTENANCE_NAME=postgres

# Google Books
# Opcional para alguns cenários de teste, mas recomendado para identificar a aplicação.
GOOGLE_BOOKS_API_KEY=

# WhatsApp / Baileys
# O Python chama o serviço Node.js local; a sessão do WhatsApp fica apenas em disco local.
WHATSAPP_PROVIDER=baileys
WHATSAPP_SERVICE_URL=http://127.0.0.1:3001
BAILEYS_SERVICE_HOST=127.0.0.1
BAILEYS_SERVICE_PORT=3001
BAILEYS_AUTH_DIR=whatsapp_service/auth_info

# Webhook local de respostas do WhatsApp
WHATSAPP_WEBHOOK_HOST=127.0.0.1
WHATSAPP_WEBHOOK_PORT=3002
WHATSAPP_WEBHOOK_URL=http://127.0.0.1:3002/webhook/whatsapp
RENOVACAO_DIAS=7

# Segurança para mensagens recebidas.
# Fica DESLIGADO por padrão. Ative apenas quando quiser testar/usar a renovação por resposta.
WHATSAPP_INBOUND_ENABLED=false
# Opcional: durante testes, limite o processamento a um único telefone autorizado.
# Informe somente dígitos com DDI e DDD; nunca commite um número real aqui.
WHATSAPP_INBOUND_ALLOWED_PHONE=

# E-mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_DESTINATARIO=
