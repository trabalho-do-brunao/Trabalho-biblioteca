# Aplicação
APP_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecf
DB_USER=postgres
DB_PASSWORD=preencha_localmente
# Banco usado para verificar/criar DB_NAME. Em instalações padrão, use postgres.
DB_MAINTENANCE_NAME=postgres

# Google Books
# Opcional para alguns cenários de teste, mas recomendado para identificar a aplicação.
GOOGLE_BOOKS_API_KEY=

# WhatsApp / provedor a definir
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# E-mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_DESTINATARIO=
