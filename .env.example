# Aplicação
APP_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecf
DB_USER=postgres
DB_PASSWORD=preencha_localmente
# Banco usado para verificar/criar DB_NAME. Em instalações padrão, use postgres.
DB_MAINTENANCE_NAME=postgres

# Google Books
# Opcional para alguns cenários de teste, mas recomendado para identificar a aplicação.
GOOGLE_BOOKS_API_KEY=

# WhatsApp / Baileys
# O Python chama o serviço Node.js local; a sessão do WhatsApp fica apenas em disco local.
WHATSAPP_PROVIDER=baileys
WHATSAPP_SERVICE_URL=http://127.0.0.1:3001
BAILEYS_SERVICE_HOST=127.0.0.1
BAILEYS_SERVICE_PORT=3001
BAILEYS_AUTH_DIR=whatsapp_service/auth_info

# Webhook local de respostas do WhatsApp
WHATSAPP_WEBHOOK_HOST=127.0.0.1
WHATSAPP_WEBHOOK_PORT=3002
WHATSAPP_WEBHOOK_URL=http://127.0.0.1:3002/webhook/whatsapp
RENOVACAO_DIAS=7

# Segurança para mensagens recebidas.
# Fica DESLIGADO por padrão. Quando ativado, somente usuários ativos cadastrados
# no PostgreSQL podem entrar no fluxo de renovação; contatos desconhecidos são ignorados.
WHATSAPP_INBOUND_ENABLED=false

# E-mail / SMTP
# Configure somente no .env local. Nunca versione credenciais reais.
# Porta 587 usa STARTTLS; porta 465 usa TLS implícito.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Endereço do responsável que receberá os relatórios automáticos.
EMAIL_DESTINATARIO=

# Automação diária
# Fica DESLIGADA por padrão para evitar envios automáticos antes da validação local.
# Quando ativada, o run.bat mantém o agendador junto com webhook e Baileys.
AUTOMACAO_ENABLED=false
# Horário local no formato HH:MM.
AUTOMACAO_HORA=08:00
# Fuso IANA usado pelo APScheduler.
AUTOMACAO_TIMEZONE=America/Sao_Paulo
# Quando true, envia por e-mail o PDF gerado pela rotina.
AUTOMACAO_ENVIAR_EMAIL=true
# 0 = relatório somente do dia; 30 = últimos 30 dias, por exemplo.
AUTOMACAO_RELATORIO_DIAS=0
